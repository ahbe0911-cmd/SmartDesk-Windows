<Window x:Class="SmartDesk.Views.QuickLinkEditorWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="افزودن لینک سریع" Width="540" Height="630" MinWidth="500" MinHeight="590"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
 FlowDirection="RightToLeft" FontFamily="Vazirmatn, B Nazanin, Titr">
 <Grid Margin="30">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" CornerRadius="22" Padding="22" Margin="0,0,0,22" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <StackPanel>
    <TextBlock x:Name="DialogTitle" Text="افزودن لینک سریع" FontFamily="Titr, Vazirmatn" FontSize="24" FontWeight="Bold"/>
    <TextBlock Text="یک میانبر شخصی بسازید؛ پس از ذخیره مستقیماً روی داشبورد نمایش داده می‌شود." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="1">
   <TextBlock Text="نام لینک" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="TitleBox" Style="{StaticResource RoundedTextBoxStyle}" MaxLength="80"/>
   <TextBlock Text="نشانی سایت" FontWeight="SemiBold" Margin="0,17,0,7"/><TextBox x:Name="UrlBox" Style="{StaticResource RoundedTextBoxStyle}" FlowDirection="LeftToRight" TextAlignment="Left" MaxLength="2048"/>
   <TextBlock Text="https://example.com" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FlowDirection="LeftToRight" HorizontalAlignment="Left" Margin="2,5,0,0"/>
   <TextBlock Text="دسته‌بندی" FontWeight="SemiBold" Margin="0,16,0,7"/><TextBox x:Name="CategoryBox" Style="{StaticResource RoundedTextBoxStyle}" MaxLength="40"/>
   <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="0"><TextBlock Text="نماد" FontWeight="SemiBold" Margin="0,0,0,7"/><TextBox x:Name="IconBox" Style="{StaticResource RoundedTextBoxStyle}" MaxLength="2" TextAlignment="Center" FontSize="20"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="رنگ کارت" FontWeight="SemiBold" Margin="0,0,0,7"/><ComboBox x:Name="AccentCombo" Height="42" Padding="9,5" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" DisplayMemberPath="Name" SelectedValuePath="Hex"/></StackPanel>
   </Grid>
   <TextBlock x:Name="ValidationText" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,17,0,0" Visibility="Collapsed"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button Grid.Column="0" Content="انصراف" Padding="14,10" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click"/>
   <Button Grid.Column="2" Content="ذخیره و افزودن به داشبورد" Padding="14,10" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click"/>
  </Grid>
 </Grid>
</Window>