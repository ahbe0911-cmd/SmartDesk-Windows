<Window x:Class="SmartDesk.Views.QuickLinkEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="مدیریت میانبر"
        Width="520"
        Height="610"
        MinWidth="480"
        MinHeight="570"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock x:Name="DialogTitle" Text="افزودن میانبر" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="عنوان و نشانی صفحه‌ای را که زیاد استفاده می‌کنید وارد کنید."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,7,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="عنوان" FontWeight="SemiBold" Margin="0,0,0,7" />
            <TextBox x:Name="TitleBox" Style="{StaticResource RoundedTextBoxStyle}" MaxLength="80" />

            <TextBlock Text="نشانی سایت" FontWeight="SemiBold" Margin="0,18,0,7" />
            <TextBox x:Name="UrlBox"
                     Style="{StaticResource RoundedTextBoxStyle}"
                     FlowDirection="LeftToRight"
                     TextAlignment="Left"
                     MaxLength="2048" />
            <TextBlock Text="نمونه: https://example.com"
                       Foreground="{DynamicResource TextMutedBrush}"
                       FontSize="12"
                       FlowDirection="LeftToRight"
                       HorizontalAlignment="Left"
                       Margin="2,5,0,0" />

            <TextBlock Text="دسته‌بندی" FontWeight="SemiBold" Margin="0,16,0,7" />
            <TextBox x:Name="CategoryBox" Style="{StaticResource RoundedTextBoxStyle}" MaxLength="40" />

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="نماد" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="IconBox"
                             Style="{StaticResource RoundedTextBoxStyle}"
                             MaxLength="2"
                             TextAlignment="Center"
                             FontSize="19" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="رنگ میانبر" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <ComboBox x:Name="AccentCombo"
                              Height="42"
                              Padding="9,5"
                              Background="{DynamicResource InputBackgroundBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Hex" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="ValidationText"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,18,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="انصراف" Style="{StaticResource SecondaryButtonStyle}" Click="Cancel_Click" />
            <Button Grid.Column="2" Content="ذخیره میانبر" Style="{StaticResource PrimaryButtonStyle}" Click="Save_Click" />
        </Grid>
    </Grid>
</Window>
