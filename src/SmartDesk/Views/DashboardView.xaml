<UserControl x:Class="SmartDesk.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" FontFamily="./Resources/Fonts/#Vazirmatn">
 <UserControl.Resources>
  <DropShadowEffect x:Key="CardShadow" BlurRadius="22" ShadowDepth="3" Opacity="0.12"/>
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#0D3B43" Offset="0"/><GradientStop Color="#12656A" Offset="0.52"/><GradientStop Color="#20877C" Offset="1"/>
  </LinearGradientBrush>
  <Style x:Key="QuickCardStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
   <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="26">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Border Grid.Row="0" CornerRadius="30" Padding="32,26" Background="{StaticResource HeroBrush}" Effect="{StaticResource CardShadow}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="میزکار هوشمند" FontSize="32" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="همه‌چیز برای شروع کار، بدون شلوغی و پنجره‌های اضافه" Margin="0,7,0,0" FontSize="14" Foreground="#DDF8F5"/>
      <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
       <Border Padding="13,8" CornerRadius="13" Background="#20FFFFFF" Margin="0,0,8,0"><TextBlock Text="●  آماده به کار" FontSize="11" Foreground="#E9FFFC"/></Border>
       <Border Padding="13,8" CornerRadius="13" Background="#20FFFFFF"><TextBlock Text="Windows 10 / 11 • x64" FontSize="11" Foreground="#E9FFFC"/></Border>
      </StackPanel>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Border CornerRadius="18" Padding="9" Margin="0,0,12,0" Background="#1EFFFFFF">
       <StackPanel Orientation="Horizontal">
        <Button Content="☀" ToolTip="تم روشن" Width="42" Height="38" Margin="0,0,5,0" Style="{StaticResource SecondaryButtonStyle}" Click="LightTheme_Click"/>
        <Button Content="☾" ToolTip="تم تیره" Width="42" Height="38" Style="{StaticResource SecondaryButtonStyle}" Click="DarkTheme_Click"/>
       </StackPanel>
      </Border>
      <Border MinWidth="178" CornerRadius="20" Padding="20,12" Background="#20FFFFFF">
       <StackPanel>
        <TextBlock x:Name="DashboardTimeText" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock x:Name="DashboardDateText" FontSize="13" Margin="0,3,0,0" Foreground="#E5FAF8" HorizontalAlignment="Center"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="1" Margin="0,20,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="26" Padding="24" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <StackPanel Orientation="Horizontal">
         <TextBlock Text="لینک‌های سریع" FontSize="23" FontWeight="Bold"/>
         <Border Margin="10,2,0,0" Padding="9,3" CornerRadius="10" Background="{DynamicResource PanelBackgroundBrush}"><TextBlock x:Name="QuickLinkCountText" Text="۰ از ۷" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/></Border>
        </StackPanel>
        <TextBlock Text="میانبرهای شخصی شما؛ افزودن، ویرایش و حذف مستقیم از همین صفحه" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
       </StackPanel>
       <Button x:Name="AddLinkButton" Grid.Column="1" Content="＋ افزودن لینک" Padding="20,11" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Click="AddLink_Click"/>
      </Grid>
      <Border Grid.Row="1" Margin="0,18" Height="1" Background="{DynamicResource BorderBrush}"/>
      <ItemsControl x:Name="DashboardQuickLinks" Grid.Row="2">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Width="188" Height="144" Margin="0,0,13,13" Padding="16" Style="{StaticResource QuickCardStyle}" Tag="{Binding}" Click="QuickLinkCard_Click">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="16" Background="{Binding AccentHex, Converter={StaticResource AccentBrushConverter}}"><TextBlock Text="{Binding Icon}" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
             <Button Content="✎" Width="30" Height="30" Padding="0" Margin="0,0,4,0" ToolTip="ویرایش" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="EditLink_Click"/>
             <Button Content="×" Width="30" Height="30" Padding="0" ToolTip="حذف" Style="{StaticResource SecondaryButtonStyle}" Tag="{Binding}" Click="DeleteLink_Click"/>
            </StackPanel>
           </Grid>
           <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Category}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </Grid>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Grid>
    </Border>

    <Border Grid.Column="1" CornerRadius="26" Padding="24" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="برنامه‌ریز یکپارچه" FontSize="22" FontWeight="Bold"/>
       <TextBlock Text="تقویم شمسی، یادداشت و یادآور در یک فضای واحد" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Grid.Row="1" Margin="0,20,0,0" CornerRadius="20" Padding="20" Background="{DynamicResource PanelBackgroundBrush}">
       <StackPanel>
        <TextBlock Text="امروز" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock x:Name="PlannerDateText" Margin="0,7,0,0" FontSize="20" FontWeight="Bold"/>
        <Border Margin="0,16,0,0" Height="1" Background="{DynamicResource BorderBrush}"/>
        <TextBlock Text="یادآورها با تاریخ شمسی و ساعت ۲۴ ساعته ثبت می‌شوند و اعلان ویندوز دریافت می‌کنید." Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}"/>
       </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Margin="0,18,0,0">
       <Border CornerRadius="16" Padding="15" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,0,0,9"><Grid><TextBlock Text="▣  تقویم شمسی" FontWeight="SemiBold"/><TextBlock Text="←" HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/></Grid></Border>
       <Border CornerRadius="16" Padding="15" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,0,0,9"><Grid><TextBlock Text="✎  یادداشت‌ها" FontWeight="SemiBold"/><TextBlock Text="←" HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/></Grid></Border>
       <Border CornerRadius="16" Padding="15" Background="{DynamicResource PanelBackgroundBrush}"><Grid><TextBlock Text="◷  یادآورها" FontWeight="SemiBold"/><TextBlock Text="←" HorizontalAlignment="Left" Foreground="{DynamicResource TextMutedBrush}"/></Grid></Border>
      </StackPanel>
      <Button Grid.Row="3" Content="باز کردن برنامه‌ریز" Padding="18,12" Style="{StaticResource PrimaryButtonStyle}" Click="Planner_Click"/>
     </Grid>
    </Border>
   </Grid>

   <Border Grid.Row="2" Margin="0,18,0,0" CornerRadius="20" Padding="18,13" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid><TextBlock Text="لینک‌ها در مرورگر داخلی تمام‌صفحه باز می‌شوند؛ Esc یا «بازگشت به میزکار» شما را مستقیم به داشبورد برمی‌گرداند." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="WebView2 • Modal" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/></Grid>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>