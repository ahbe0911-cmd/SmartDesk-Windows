<UserControl x:Class="SmartDesk.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="26" Padding="28" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="میزکار هوشمند" FontSize="31" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="لینک‌ها، تقویم و یادآورها؛ ساده، سریع و همیشه در دسترس" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="18" Padding="16,10" Margin="0,0,10,0" Background="{DynamicResource PanelBackgroundBrush}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="LightThemeButton" Content="☀  روشن" Padding="13,7" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="LightTheme_Click"/>
                                <Button x:Name="DarkThemeButton" Content="☾  تیره" Padding="13,7" Style="{StaticResource SecondaryButtonStyle}" Click="DarkTheme_Click"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="18" Padding="18,10" Background="{DynamicResource PanelBackgroundBrush}">
                            <StackPanel>
                                <TextBlock x:Name="DashboardDateText" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DashboardTimeText" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,24,0,0">
                <StackPanel>
                    <TextBlock Text="لینک‌های سریع" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="۷ دسترسی اصلی؛ هر لینک داخل SmartDesk باز می‌شود" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>

            <ItemsControl x:Name="DashboardQuickLinks" Grid.Row="2" Margin="0,14,0,0">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="158" Height="122" Margin="0,0,12,12" Padding="15" Style="{StaticResource BaseButtonStyle}" Tag="{Binding}" Click="QuickLinkCard_Click">
                            <StackPanel>
                                <Border Width="46" Height="46" CornerRadius="15" Background="{Binding AccentHex, Converter={StaticResource AccentBrushConverter}}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" Margin="0,10,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Category}" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Margin="0,0,12,0" Padding="22" Style="{StaticResource SecondaryButtonStyle}" Click="Calendar_Click">
                    <StackPanel><TextBlock Text="▣" FontSize="28"/><TextBlock Text="تقویم شمسی" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="امروز، ماه شمسی و روزهای یادآوری" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Padding="22" Style="{StaticResource SecondaryButtonStyle}" Click="NotesReminders_Click">
                    <StackPanel><TextBlock Text="✎" FontSize="28"/><TextBlock Text="یادداشت و یادآور" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="ثبت یادداشت و تنظیم اعلان ویندوز در زمان دلخواه" FontSize="12" Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}"/></StackPanel>
                </Button>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>