<UserControl x:Class="SmartDesk.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" CornerRadius="22" Padding="28" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="میزکار هوشمند" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="همه ابزارهای روزانه، لینک‌ها و مرورگر در یک فضای منظم" Margin="0,8,0,0" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="18" Padding="18,12" Background="{DynamicResource PanelBackgroundBrush}">
                        <StackPanel>
                            <TextBlock x:Name="DashboardDateText" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="DashboardTimeText" FontSize="25" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="0,22,0,0">
                <TextBlock Text="لینک‌های سریع" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="۷ دسترسی اصلی شما" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>

            <ItemsControl x:Name="DashboardQuickLinks" Grid.Row="2" Margin="0,12,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="150" Height="116" Margin="0,0,12,12" Padding="14" Style="{StaticResource BaseButtonStyle}" Tag="{Binding}" Click="QuickLinkCard_Click">
                            <StackPanel>
                                <Border Width="42" Height="42" CornerRadius="13" Background="{Binding AccentHex, Converter={StaticResource AccentBrushConverter}}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" Margin="0,10,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Category}" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <UniformGrid Grid.Row="3" Columns="4" Margin="0,12,0,0">
                <Button Margin="0,0,10,0" Padding="18" Style="{StaticResource SecondaryButtonStyle}" Click="QuickNote_Click"><StackPanel><TextBlock Text="✎" FontSize="24"/><TextBlock Text="یادداشت سریع" Margin="0,7,0,0"/></StackPanel></Button>
                <Button Margin="0,0,10,0" Padding="18" Style="{StaticResource SecondaryButtonStyle}" Click="Calendar_Click"><StackPanel><TextBlock Text="▣" FontSize="24"/><TextBlock Text="تقویم شمسی" Margin="0,7,0,0"/></StackPanel></Button>
                <Button Margin="0,0,10,0" Padding="18" Style="{StaticResource SecondaryButtonStyle}" Click="TodayTasks_Click"><StackPanel><TextBlock Text="✓" FontSize="24"/><TextBlock Text="کارهای امروز" Margin="0,7,0,0"/></StackPanel></Button>
                <Button Padding="18" Style="{StaticResource SecondaryButtonStyle}" Click="Tools_Click"><StackPanel><TextBlock Text="▦" FontSize="24"/><TextBlock Text="ابزارها" Margin="0,7,0,0"/></StackPanel></Button>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>