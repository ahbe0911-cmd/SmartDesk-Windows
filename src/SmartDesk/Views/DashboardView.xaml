<UserControl x:Class="SmartDesk.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SmartDesk.Views"
 FlowDirection="RightToLeft" FontFamily="./Resources/Fonts/#Far.Nazanin" Background="Transparent">
 <UserControl.Resources>
  <DropShadowEffect x:Key="Shadow" BlurRadius="22" ShadowDepth="2" Opacity="0.10"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#FCFDFD"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="16"/><Setter Property="Effect" Value="{StaticResource Shadow}"/></Style>
  <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="FontFamily" Value="Vazirmatn"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="11,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="FontFamily" Value="Vazirmatn"/><Setter Property="Height" Value="52"/><Setter Property="Margin" Value="16,4"/><Setter Property="Padding" Value="18,0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Foreground" Value="#F3FAFA"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="15"/></Style>
 </UserControl.Resources>

 <Grid FlowDirection="LeftToRight"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#D9D7E4DC" Offset="0"/><GradientStop Color="#BFA6B7A9" Offset=".42"/><GradientStop Color="#D96B7D73" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>

  <!-- MAIN WORKSPACE -->
  <Grid Grid.Column="0">
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>

   <!-- top bar -->
   <Border Grid.Row="0" Background="#DDF9FBFC" BorderBrush="#E7ECEF" BorderThickness="0,0,0,1">
    <Grid Margin="22,0" FlowDirection="LeftToRight">
     <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Border Width="48" Height="48" CornerRadius="15" Background="#DDF6EC"><TextBlock Text="❧" FontSize="30" Foreground="#17B87F" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel Margin="12,0,0,0"><TextBlock Text="SmartDesk" FontSize="24" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold" Foreground="#101A1E"/><TextBlock Text="میزکار هوشمند شما" FontSize="11" Foreground="#68767C" FlowDirection="RightToLeft"/></StackPanel>
     </StackPanel>
     <Border Grid.Column="1" Width="420" Height="40" CornerRadius="23" Background="#EEF2F4" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid FlowDirection="RightToLeft"><TextBlock Text="⌕" FontSize="23" Foreground="#5F737D" Margin="15,0" VerticalAlignment="Center"/><TextBox x:Name="DashboardSearchBox" Margin="48,0,16,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Foreground="#5F6D72" ToolTip="جستجو در لینک‌های کاربردی" TextChanged="DashboardSearchBox_TextChanged"/></Grid>
     </Border>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Button Content="☀" Width="42" Height="42" Style="{StaticResource SoftButton}" Background="#F2F5F6" Click="LightTheme_Click"/>
      <Button Content="☾" Width="42" Height="42" Margin="8,0" Style="{StaticResource SoftButton}" Background="#F2F5F6" Click="DarkTheme_Click"/>
      <Button Content="⚙" Width="42" Height="42" Style="{StaticResource SoftButton}" Background="#F2F5F6"/>
     </StackPanel>
    </Grid>
   </Border>

   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="26,18,26,14">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="116"/></Grid.RowDefinitions>
     <Grid FlowDirection="LeftToRight">
      <Grid.ColumnDefinitions><ColumnDefinition Width="31*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="43*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="26*"/></Grid.ColumnDefinitions>

      <!-- LEFT: clock/calendar/weather -->
      <Grid Grid.Column="0">
       <Grid.RowDefinitions><RowDefinition Height="212"/><RowDefinition Height="14"/><RowDefinition Height="284"/><RowDefinition Height="14"/><RowDefinition Height="142"/></Grid.RowDefinitions>
       <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
        <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="48*"/><ColumnDefinition Width="52*"/></Grid.ColumnDefinitions>
         <Border CornerRadius="18,0,0,18"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#071F20"/><GradientStop Color="#0E4540" Offset="1"/></LinearGradientBrush></Border.Background><local:AnalogClockControl Margin="14"/></Border>
         <StackPanel Grid.Column="1" Margin="18" VerticalAlignment="Center" FlowDirection="RightToLeft">
          <TextBlock x:Name="DashboardTimeText" FontSize="36" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold" Foreground="#111D21"/>
          <TextBlock Text="سه‌شنبه" Margin="0,8,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#34454B"/>
          <TextBlock x:Name="DashboardDateText" Margin="0,3" FontSize="12" Foreground="#5E6E74"/>
         </StackPanel>
        </Grid>
       </Border>
       <Border Grid.Row="2" Style="{StaticResource Card}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid FlowDirection="RightToLeft"><TextBlock x:Name="CalendarTitleText" FontSize="18" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold" Foreground="#1E2C31"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight"><Button Content="‹" Width="32" Style="{StaticResource SoftButton}" Background="Transparent" Click="PreviousMonth_Click"/><Button Content="امروز" Margin="5,0" Style="{StaticResource SoftButton}" Background="#E8F6F1" Foreground="#168B6B" Click="Today_Click"/><Button Content="›" Width="32" Style="{StaticResource SoftButton}" Background="Transparent" Click="NextMonth_Click"/></StackPanel></Grid>
         <UniformGrid Grid.Row="1" Columns="7" FlowDirection="RightToLeft"><TextBlock Text="ش" HorizontalAlignment="Center"/><TextBlock Text="ی" HorizontalAlignment="Center"/><TextBlock Text="د" HorizontalAlignment="Center"/><TextBlock Text="س" HorizontalAlignment="Center"/><TextBlock Text="چ" HorizontalAlignment="Center"/><TextBlock Text="پ" HorizontalAlignment="Center"/><TextBlock Text="ج" Foreground="#D84E55" HorizontalAlignment="Center"/></UniformGrid>
         <UniformGrid x:Name="CalendarDaysGrid" Grid.Row="2" Columns="7" Rows="6" FlowDirection="RightToLeft"/>
        </Grid>
       </Border>
       <Border Grid.Row="4" Style="{StaticResource Card}">
        <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions>
         <TextBlock Text="🌤" FontSize="48" VerticalAlignment="Center" HorizontalAlignment="Center"/>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock Text="مینودشت" FontSize="11" Foreground="#53646A"/><TextBlock Text="۲۴°" FontSize="36" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold" Foreground="#152329"/><TextBlock Text="نیمه ابری" FontSize="12" Foreground="#596A70"/></StackPanel>
         <StackPanel Grid.Column="2" VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock Text="↑ ۲۸°" Foreground="#C65B5B"/><TextBlock Text="↓ ۱۶°" Margin="0,10,0,0" Foreground="#5D8090"/></StackPanel>
        </Grid>
       </Border>
      </Grid>

      <!-- CENTER: note + tasks -->
      <Grid Grid.Column="2">
       <Grid.RowDefinitions><RowDefinition Height="360"/><RowDefinition Height="14"/><RowDefinition Height="278"/></Grid.RowDefinitions>
       <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>
         <Grid Margin="20,0" FlowDirection="RightToLeft"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="32" Height="32" CornerRadius="8" Background="#12A985"><TextBlock Text="✎" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="یادداشت سریع" FontSize="19" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold" Margin="10,0" VerticalAlignment="Center"/></StackPanel></Grid>
         <Grid Grid.Row="1" Margin="16,0"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,1,30" ViewportUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#F9FBFC"><GeometryDrawing.Pen><Pen Brush="#E7ECEF" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><LineGeometry StartPoint="0,29" EndPoint="600,29"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Grid.Background>
          <TextBox AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="16" FontSize="14" Foreground="#43545A" ToolTip="اینجا یادداشت کنید ..."/>
         </Grid>
         <Grid Grid.Row="2" Margin="16,0" FlowDirection="RightToLeft"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="▥   ☷   ⛶" Foreground="#687A81" FontSize="16"/></StackPanel><Button Content="ذخیره" Width="96" Height="34" HorizontalAlignment="Left" Style="{StaticResource SoftButton}" Background="#0FA77F" Foreground="White"/></Grid>
        </Grid>
       </Border>
       <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
        <Grid><Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
         <Grid FlowDirection="RightToLeft"><StackPanel Orientation="Horizontal"><TextBlock Text="☑" Foreground="#159B78" FontSize="22"/><TextBlock Text="کارهای امروز" Margin="8,0" FontSize="18" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold"/></StackPanel><Button Content="＋ افزودن کار" HorizontalAlignment="Left" Style="{StaticResource SoftButton}" Background="#0FA77F" Foreground="White" Click="Planner_Click"/></Grid>
         <StackPanel Grid.Row="1">
          <CheckBox Content="پاسخ به پیام‌ها" IsChecked="True" Margin="4,8" FontSize="13"/>
          <CheckBox Content="بررسی اخبار کتابخانه" Margin="4,8" FontSize="13"/>
          <CheckBox Content="تهیه گزارش هفتگی" Margin="4,8" FontSize="13"/>
          <CheckBox Content="مطالعه و تحقیق" Margin="4,8" FontSize="13"/>
          <CheckBox Content="ورزش و پیاده روی" Margin="4,8" FontSize="13"/>
         </StackPanel>
        </Grid>
       </Border>
      </Grid>

      <!-- RIGHT: quick links + tools -->
      <Grid Grid.Column="4">
       <Grid.RowDefinitions><RowDefinition Height="420"/><RowDefinition Height="14"/><RowDefinition Height="218"/></Grid.RowDefinitions>
       <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
         <Grid FlowDirection="RightToLeft"><TextBlock Text="لینک‌های سریع" FontSize="18" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="🔗" FontSize="20" Foreground="#0EA67E" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid>
         <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DashboardQuickLinks"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="QuickLinkCard_Click" Margin="4" MinHeight="84" Style="{StaticResource SoftButton}" Background="#DDF6F9FA"><StackPanel><Border Width="38" Height="38" CornerRadius="19" Background="White"><TextBlock Text="{Binding Icon}" FontSize="18" Foreground="#149D7C" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Title}" Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
         <Button Grid.Row="2" x:Name="AddLinkButton" Content="＋  افزودن لینک جدید" Margin="4,7,4,0" Style="{StaticResource SoftButton}" Background="#DDF1F5F6" Foreground="#2D3E44" Click="AddLink_Click"/>
         <TextBlock x:Name="QuickLinkCountText" Visibility="Collapsed"/>
        </Grid>
       </Border>
       <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
        <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid FlowDirection="RightToLeft"><TextBlock Text="ابزارهای کاربردی" FontSize="17" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold"/><TextBlock Text="▦" FontSize="20" Foreground="#0EA67E" HorizontalAlignment="Left"/></Grid>
         <UniformGrid Grid.Row="1" Columns="3" Rows="2">
          <Button Style="{StaticResource SoftButton}" Margin="4" Background="#DDF7FAFA" Content="🌐&#10;مرورگر داخلی"/>
          <Button Style="{StaticResource SoftButton}" Margin="4" Background="#F7FAFA" Content="▦&#10;ماشین حساب"/>
          <Button Style="{StaticResource SoftButton}" Margin="4" Background="#F7FAFA" Content="🔔&#10;یادآور" Click="Planner_Click"/>
          <Button Style="{StaticResource SoftButton}" Margin="4" Background="#F7FAFA" Content="📷&#10;عکس‌برداری"/>
          <Button Style="{StaticResource SoftButton}" Margin="4" Background="#F7FAFA" Content="▣&#10;ویدیو"/>
          <Button Style="{StaticResource SoftButton}" Margin="4" Background="#F7FAFA" Content="📁&#10;فایل‌ها"/>
         </UniformGrid>
        </Grid>
       </Border>
      </Grid>
     </Grid>

     <!-- bottom inspiration banner -->
     <Border Grid.Row="2" CornerRadius="18" ClipToBounds="True">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#263B36"/><GradientStop Color="#87958D" Offset=".38"/><GradientStop Color="#E8E4E1" Offset="1"/></LinearGradientBrush></Border.Background>
      <Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="45*"/><ColumnDefinition Width="55*"/></Grid.ColumnDefinitions>
       <Canvas><Ellipse Width="150" Height="150" Fill="#2F5144" Opacity=".45" Canvas.Left="18" Canvas.Top="-24"/><Rectangle Width="250" Height="50" RadiusX="8" RadiusY="8" Fill="#B3AAA2" Canvas.Left="70" Canvas.Top="50" RenderTransformOrigin=".5,.5"><Rectangle.RenderTransform><RotateTransform Angle="-8"/></Rectangle.RenderTransform></Rectangle></Canvas>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="28" FlowDirection="RightToLeft"><TextBlock Text="هر روز فرصتی تازه است" FontSize="19" FontFamily="./Resources/Fonts/#Far.Titr" FontWeight="Bold" Foreground="#172328"/><TextBlock Text="برای شروعی بهتر ..." Margin="0,7,0,0" FontSize="15" Foreground="#35454A"/></StackPanel>
      </Grid>
     </Border>
    </Grid>
   </ScrollViewer>

   <Border Grid.Row="2" Background="#F8FAFB" BorderBrush="#E5EAED" BorderThickness="0,1,0,0">
    <Grid Margin="26,0" FlowDirection="LeftToRight"><TextBlock Text="▣   ۱۰:۲۴  |  سه‌شنبه ۲۷ شهریور ۱۴۰۵" FontSize="10" Foreground="#607077" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#13A87F"/><TextBlock Text="  آنلاین     |     SmartDesk V8" FontSize="10" Foreground="#607077"/></StackPanel></Grid>
   </Border>
  </Grid>

  <!-- RIGHT QUICK ACCESS SIDEBAR -->
  <Border Grid.Column="1" Margin="12" CornerRadius="24" Background="#E6072025" BorderBrush="#557A8C91" BorderThickness="1">
   <Grid Margin="14">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="62"/><RowDefinition Height="32"/></Grid.RowDefinitions>
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
     <ItemsControl x:Name="SidebarQuickLinks">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate>
       <Button Tag="{Binding}" Click="QuickLinkCard_Click" Margin="5" MinHeight="104" Style="{StaticResource SoftButton}" Background="#2BFFFFFF" BorderBrush="#5AFFFFFF" BorderThickness="1">
        <StackPanel><Border Width="44" Height="44" CornerRadius="14" Background="#36FFFFFF"><TextBlock Text="{Binding Icon}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Title}" Foreground="White" Margin="0,9,0,0" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel>
       </Button>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </ScrollViewer>
    <Button Grid.Row="1" Content="＋  افزودن لینک جدید" Margin="5,8,5,0" Style="{StaticResource SoftButton}" Background="#183C4145" Foreground="White" BorderBrush="#88D8E5E6" BorderThickness="1" Click="AddLink_Click"/>
    <TextBlock Grid.Row="2" Text="SmartDesk V8" Foreground="#9DB7BC" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
   </Grid>
  </Border>
 </Grid>
</UserControl>