<UserControl x:Class="SmartDesk.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" FontFamily="Vazirmatn, B Nazanin, Titr">
 <UserControl.Resources>
  <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.14"/>
  <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
   <GradientStop Color="#123C45" Offset="0"/><GradientStop Color="#176B72" Offset="0.55"/><GradientStop Color="#2A8C82" Offset="1"/>
  </LinearGradientBrush>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <Border Grid.Row="0" CornerRadius="28" Padding="30,24" Background="{StaticResource HeroBrush}" Effect="{StaticResource CardShadow}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="میزکار هوشمند" FontFamily="Titr, Vazirmatn" FontSize="31" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="خانه‌ی ساده و سریع برای لینک‌ها، برنامه‌ریزی و کارهای روزانه" Margin="0,7,0,0" FontSize="14" Foreground="#DDF8F5"/>
      <Border Margin="0,18,0,0" Padding="14,9" CornerRadius="14" Background="#22FFFFFF" HorizontalAlignment="Right">
       <TextBlock Text="SmartDesk • Dashboard V5" FontSize="12" Foreground="White"/>
      </Border>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Border CornerRadius="18" Padding="12,9" Margin="0,0,12,0" Background="#22FFFFFF">
       <StackPanel Orientation="Horizontal">
        <Button Content="☀  روشن" Padding="12,7" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="LightTheme_Click"/>
        <Button Content="☾  تیره" Padding="12,7" Style="{StaticResource SecondaryButtonStyle}" Click="DarkTheme_Click"/>
       </StackPanel>
      </Border>
      <Border CornerRadius="18" Padding="18,10" Background="#22FFFFFF">
       <StackPanel>
        <TextBlock x:Name="DashboardTimeText" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock x:Name="DashboardDateText" FontFamily="B Nazanin, Vazirmatn" FontSize="13" Margin="0,3,0,0" Foreground="#E5FAF8" HorizontalAlignment="Center"/>
       </StackPanel>
      </Border>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="1" Margin="0,22,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Margin="0,0,16,0" CornerRadius="26" Padding="24" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="لینک‌های سریع" FontFamily="Titr, Vazirmatn" FontSize="23" FontWeight="Bold"/>
        <TextBlock Text="حداکثر ۷ میانبر شخصی؛ لینک جدید را خودتان اضافه کنید." Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
       </StackPanel>
       <Button Grid.Column="1" Content="＋ افزودن لینک" Padding="20,11" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Click="AddLink_Click"/>
      </Grid>
      <Border Grid.Row="1" Margin="0,18,0,18" Height="1" Background="{DynamicResource BorderBrush}"/>
      <ItemsControl x:Name="DashboardQuickLinks" Grid.Row="2">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Width="180" Height="138" Margin="0,0,13,13" Padding="16" Style="{StaticResource BaseButtonStyle}" Tag="{Binding}" Click="QuickLinkCard_Click">
          <Grid>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Width="50" Height="50" CornerRadius="16" Background="{Binding AccentHex, Converter={StaticResource AccentBrushConverter}}">
             <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="21" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Grid.Column="1" Text="↗" FontSize="16" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top"/>
           </Grid>
           <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Category}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
           </StackPanel>
          </Grid>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </Grid>
    </Border>

    <Border Grid.Column="1" CornerRadius="26" Padding="24" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Effect="{StaticResource CardShadow}">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel>
       <TextBlock Text="برنامه‌ریز یکپارچه" FontFamily="Titr, Vazirmatn" FontSize="22" FontWeight="Bold"/>
       <TextBlock Text="تقویم شمسی، یادداشت و یادآور؛ همه در یک جا" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Grid.Row="1" Margin="0,20,0,0" CornerRadius="20" Padding="20" Background="{DynamicResource PanelBackgroundBrush}">
       <StackPanel>
        <TextBlock Text="امروز" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock x:Name="PlannerDateText" FontFamily="B Nazanin, Vazirmatn" Margin="0,7,0,0" FontSize="21" FontWeight="Bold"/>
        <TextBlock Text="●  یادداشت‌ها و یادآورها با تاریخ شمسی و ساعت ۲۴ ساعته" Margin="0,16,0,0" TextWrapping="Wrap" FontSize="12" LineHeight="21" Foreground="{DynamicResource TextSecondaryBrush}"/>
       </StackPanel>
      </Border>
      <StackPanel Grid.Row="2" Margin="0,20,0,0">
       <Border CornerRadius="16" Padding="16" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal"><TextBlock Text="◫" FontSize="20" Margin="0,0,10,0"/><TextBlock Text="تقویم شمسی" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
       </Border>
       <Border CornerRadius="16" Padding="16" Background="{DynamicResource PanelBackgroundBrush}" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal"><TextBlock Text="✎" FontSize="20" Margin="0,0,10,0"/><TextBlock Text="یادداشت و یادآور" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
       </Border>
      </StackPanel>
      <Button Grid.Row="3" Content="باز کردن برنامه‌ریز  ←" Padding="18,12" Style="{StaticResource PrimaryButtonStyle}" Click="Planner_Click"/>
     </Grid>
    </Border>
   </Grid>

   <Border Grid.Row="2" Margin="0,18,0,0" CornerRadius="20" Padding="18,13" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid><TextBlock Text="هر لینک در مرورگر داخلی تمام‌صفحه باز می‌شود؛ با بستن مرورگر مستقیماً به همین خانه برمی‌گردید." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="WebView2" HorizontalAlignment="Left" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/></Grid>
   </Border>
  </Grid>
 </ScrollViewer>
</UserControl>