<UserControl x:Class="SmartDesk.Views.DashboardView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FlowDirection="RightToLeft" FontFamily="Vazirmatn, B Nazanin, Titr">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

  <Border Grid.Row="0" CornerRadius="24" Padding="24,18" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="میزکار هوشمند" FontFamily="Titr, Vazirmatn" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
     <TextBlock Text="دسترسی سریع، برنامه‌ریزی ساده، تمرکز بیشتر" Margin="0,5,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"/>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Border CornerRadius="14" Padding="10,7" Margin="0,0,10,0" Background="{DynamicResource PanelBackgroundBrush}">
      <StackPanel Orientation="Horizontal">
       <Button Content="☀" ToolTip="تم روشن" Width="38" Height="34" Margin="0,0,4,0" Style="{StaticResource SecondaryButtonStyle}" Click="LightTheme_Click"/>
       <Button Content="☾" ToolTip="تم تیره" Width="38" Height="34" Style="{StaticResource SecondaryButtonStyle}" Click="DarkTheme_Click"/>
      </StackPanel>
     </Border>
     <Border CornerRadius="14" Padding="16,8" Background="{DynamicResource PanelBackgroundBrush}">
      <StackPanel>
       <TextBlock x:Name="DashboardTimeText" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/>
       <TextBlock x:Name="DashboardDateText" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Grid>
  </Border>

  <Grid Grid.Row="1" Margin="0,18,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>

   <Border Grid.Column="0" Margin="0,0,14,0" CornerRadius="24" Padding="22" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Grid.Row="0" Margin="0,0,0,18">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="لینک‌های سریع" FontFamily="Titr, Vazirmatn" FontSize="21" FontWeight="Bold"/>
       <TextBlock Text="تا ۷ سایت پرکاربرد؛ با کلیک، تمام‌صفحه داخل SmartDesk باز می‌شوند" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="＋ افزودن لینک" Padding="18,10" VerticalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Click="AddLink_Click"/>
     </Grid>
     <ItemsControl x:Name="DashboardQuickLinks" Grid.Row="1">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Button Width="174" Height="132" Margin="0,0,12,12" Padding="16" Style="{StaticResource BaseButtonStyle}" Tag="{Binding}" Click="QuickLinkCard_Click">
         <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Width="48" Height="48" CornerRadius="15" Background="{Binding AccentHex, Converter={StaticResource AccentBrushConverter}}" HorizontalAlignment="Right">
           <TextBlock Text="{Binding Icon}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Row="1" VerticalAlignment="Bottom">
           <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Category}" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
         </Grid>
        </Button>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </Grid>
   </Border>

   <Border Grid.Column="1" CornerRadius="24" Padding="22" Background="{DynamicResource ElevatedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock Text="برنامه‌ریز" FontFamily="Titr, Vazirmatn" FontSize="21" FontWeight="Bold"/>
      <TextBlock Text="تقویم، یادداشت و یادآور در یک بخش" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="0,26,0,0">
      <Border CornerRadius="18" Padding="18" Background="{DynamicResource PanelBackgroundBrush}">
       <StackPanel>
        <TextBlock Text="امروز" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
        <TextBlock x:Name="PlannerDateText" Margin="0,6,0,0" FontSize="18" FontWeight="SemiBold"/>
        <Separator Margin="0,16,0,14"/>
        <TextBlock Text="برای دیدن تقویم، ثبت یادداشت یا تنظیم یادآور، برنامه‌ریز را باز کنید." TextWrapping="Wrap" FontSize="13" LineHeight="22" Foreground="{DynamicResource TextSecondaryBrush}"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <Button Grid.Row="2" Content="باز کردن برنامه‌ریز  ←" Padding="16,11" Style="{StaticResource PrimaryButtonStyle}" Click="Planner_Click"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</UserControl>