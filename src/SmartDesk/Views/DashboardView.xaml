<UserControl x:Class="SmartDesk.Views.DashboardView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SmartDesk.Views" FlowDirection="RightToLeft" FontFamily="./Resources/Fonts/#Vazirmatn" Background="#F3F6F7">
 <UserControl.Resources>
  <DropShadowEffect x:Key="Shadow" BlurRadius="24" ShadowDepth="2" Opacity="0.09"/>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="20"/><Setter Property="Effect" Value="{StaticResource Shadow}"/></Style>
  <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="20" FlowDirection="LeftToRight">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" CornerRadius="22" Background="White" Padding="18,13" Effect="{StaticResource Shadow}">
    <Grid FlowDirection="LeftToRight">
     <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="42" Height="42" CornerRadius="14" Background="#E4F5EF"><TextBlock Text="❧" Foreground="#36A985" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0" FlowDirection="LeftToRight"><TextBlock Text="SmartDesk" FontSize="19" FontWeight="Bold" Foreground="#18252B"/><TextBlock Text="میزکار هوشمند شما" FontSize="10" Foreground="#8C989D" FlowDirection="RightToLeft"/></StackPanel></StackPanel>
     <Border Grid.Column="1" Margin="35,0" Height="42" CornerRadius="21" Background="#F4F6F7"><Grid FlowDirection="RightToLeft"><TextBlock Text="⌕" FontSize="20" Foreground="#839095" Margin="14,0" VerticalAlignment="Center"/><TextBox x:Name="DashboardSearchBox" Margin="42,0,10,0" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Foreground="#66747A" Text="" ToolTip="جستجو در لینک‌های کاربردی" TextChanged="DashboardSearchBox_TextChanged"/></Grid></Border>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="RightToLeft"><Border Width="40" Height="40" CornerRadius="20" Background="#E8F4F0"><TextBlock Text="س" Foreground="#2D9C7D" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0"><TextBlock Text="سلام، خوش آمدید" FontWeight="SemiBold" Foreground="#26353A"/><TextBlock Text="روز خوبی داشته باشید" FontSize="10" Foreground="#99A2A6"/></StackPanel><Button Content="☀" Width="36" Height="36" Style="{StaticResource SoftButton}" Background="#F5F6F7" Click="LightTheme_Click"/></StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="2" FlowDirection="LeftToRight">
    <Grid.ColumnDefinitions><ColumnDefinition Width="32*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="42*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="26*"/></Grid.ColumnDefinitions>

    <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="220"/><RowDefinition Height="16"/><RowDefinition Height="330"/><RowDefinition Height="16"/><RowDefinition Height="145"/></Grid.RowDefinitions>
     <Border Grid.Row="0" Style="{StaticResource Card}" Padding="0"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="46*"/><ColumnDefinition Width="54*"/></Grid.ColumnDefinitions><Border CornerRadius="22,0,0,22"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#153C3D"/><GradientStop Color="#347566" Offset="1"/></LinearGradientBrush></Border.Background><local:AnalogClockControl Margin="18"/></Border><StackPanel Grid.Column="1" Margin="20" FlowDirection="RightToLeft" VerticalAlignment="Center"><TextBlock x:Name="DashboardTimeText" FontSize="35" FontWeight="Bold" Foreground="#1E2B30"/><TextBlock x:Name="DashboardDateText" Margin="0,4" FontSize="13" Foreground="#66757B"/><TextBlock Text="امروز فرصتی تازه برای ساختن است؛&#10;با تمرکز شروع کن." Margin="0,15,0,0" FontSize="11" Foreground="#A0A9AD" TextWrapping="Wrap"/></StackPanel></Grid></Border>
     <Border Grid.Row="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid FlowDirection="RightToLeft"><StackPanel><TextBlock x:Name="CalendarTitleText" Text="تقویم شمسی" FontSize="20" FontWeight="Bold" Foreground="#26353A"/><TextBlock Text="ماه جاری" FontSize="10" Foreground="#9AA4A8"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="LeftToRight"><Button Content="‹" Width="34" Style="{StaticResource SoftButton}" Background="#F3F6F7" Click="PreviousMonth_Click"/><Button Content="امروز" Margin="7,0" Style="{StaticResource SoftButton}" Background="#E8F6F1" Foreground="#269678" Click="Today_Click"/><Button Content="›" Width="34" Style="{StaticResource SoftButton}" Background="#F3F6F7" Click="NextMonth_Click"/></StackPanel></Grid><UniformGrid Grid.Row="1" Columns="7" FlowDirection="RightToLeft"><TextBlock Text="ش"/><TextBlock Text="ی"/><TextBlock Text="د"/><TextBlock Text="س"/><TextBlock Text="چ"/><TextBlock Text="پ"/><TextBlock Text="ج" Foreground="#D86666"/></UniformGrid><UniformGrid x:Name="CalendarDaysGrid" Grid.Row="2" Columns="7" Rows="6" FlowDirection="RightToLeft"/><Button Grid.Row="3" Content="باز کردن برنامه‌ریز و یادآورها" Margin="0,8,0,0" Style="{StaticResource SoftButton}" Background="#EDF8F4" Foreground="#278F73" Click="Planner_Click"/></Grid></Border>
     <Border Grid.Row="4" Style="{StaticResource Card}"><Grid FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><TextBlock Text="☀" FontSize="48" Foreground="#F4B83E" VerticalAlignment="Center" HorizontalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock Text="مینودشت  ⌖" FontSize="11" Foreground="#7C898E"/><TextBlock Text="۲۴°" FontSize="34" FontWeight="Bold" Foreground="#26353A"/><TextBlock Text="آفتابی" FontSize="11" Foreground="#8A969B"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock Text="حداکثر  ۲۸°" FontSize="11"/><TextBlock Text="حداقل    ۱۸°" FontSize="11" Margin="0,10,0,0"/></StackPanel></Grid></Border>
    </Grid>

    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="44"/><RowDefinition Height="*"/><RowDefinition Height="44"/></Grid.RowDefinitions><Grid Margin="22,15" FlowDirection="RightToLeft"><StackPanel Orientation="Horizontal"><TextBlock Text="✎" FontSize="20" Foreground="#38A98A"/><TextBlock Text="دفترچه یادداشت" FontSize="21" FontWeight="Bold" Margin="8,0" Foreground="#26353A"/></StackPanel><Button Content="＋ یادداشت جدید" HorizontalAlignment="Left" Style="{StaticResource SoftButton}" Background="#3AA889" Foreground="White" Click="Planner_Click"/></Grid><Border Grid.Row="1" Background="#FAFBFB" BorderBrush="#EEF1F2" BorderThickness="0,1"><Grid Margin="20,0"><TextBlock Text="همه یادداشت‌ها  ▾" VerticalAlignment="Center" Foreground="#758288"/><TextBlock Text="⌖     ♲" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#89969A"/></Grid></Border><Grid Grid.Row="2" Margin="22,10"><Grid.Background><DrawingBrush TileMode="Tile" Viewport="0,0,1,28" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="White"><GeometryDrawing.Pen><Pen Brush="#EDF1F2" Thickness="1"/></GeometryDrawing.Pen><GeometryDrawing.Geometry><LineGeometry StartPoint="0,27" EndPoint="500,27"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush></Grid.Background><Border Width="1" Background="#F0BFC4" HorizontalAlignment="Right" Margin="0,0,34,0"/><TextBox AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="18,16,45,16" FontSize="14" Foreground="#536166" VerticalScrollBarVisibility="Auto" ToolTip="یادداشت خود را اینجا بنویسید..."/></Grid><Grid Grid.Row="3" Margin="22,0" FlowDirection="RightToLeft"><TextBlock Text="◷  ۱۵:۲۵" Foreground="#8C989C" VerticalAlignment="Center"/><TextBlock Text="✓  ذخیره خودکار فعال است" Foreground="#35A384" HorizontalAlignment="Left" VerticalAlignment="Center"/></Grid></Grid></Border>

    <Grid Grid.Column="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="175"/></Grid.RowDefinitions><StackPanel Margin="2,0,2,12" FlowDirection="RightToLeft"><TextBlock Text="لینک‌های کاربردی" FontSize="20" FontWeight="Bold" Foreground="#26353A"/><TextBlock x:Name="QuickLinkCountText" Text="۰ از ۷ • دسترسی سریع" FontSize="10" Foreground="#929DA1"/></StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="DashboardQuickLinks"><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding}" Click="QuickLinkCard_Click" Margin="0,0,0,10" Padding="14" MinHeight="62" HorizontalContentAlignment="Stretch" Style="{StaticResource SoftButton}" Background="#EEF7FA"><Grid FlowDirection="RightToLeft"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="White"><TextBlock Text="{Binding Icon}" Foreground="#318DA5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#344247" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Category}" FontSize="9" Foreground="#89969A"/></StackPanel><TextBlock Grid.Column="2" Text="←" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7B898E"/></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Button Grid.Row="1" x:Name="AddLinkButton" Content="＋ افزودن لینک" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,8,8" Style="{StaticResource SoftButton}" Background="#3AA889" Foreground="White" Click="AddLink_Click"/><Border Grid.Row="3" CornerRadius="22" Padding="20"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E5F5F7"/><GradientStop Color="#F2F9F5" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel VerticalAlignment="Center" FlowDirection="RightToLeft"><TextBlock Text="“" FontSize="38" Foreground="#9BCFC5"/><TextBlock Text="تمرکز، آغاز هر کار بزرگ است.&#10;آرام و پیوسته ادامه بده." FontSize="14" FontWeight="Bold" Foreground="#35545A" TextWrapping="Wrap"/><Border Width="44" Height="3" Background="#35A384" CornerRadius="2" HorizontalAlignment="Right" Margin="0,14,0,0"/></StackPanel></Border></Grid>
   </Grid>
  </Grid>
 </ScrollViewer>
</UserControl>