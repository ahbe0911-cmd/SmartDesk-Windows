<Window x:Class="SmartDesk.Views.QuickLinkBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SmartDesk" WindowState="Maximized" WindowStyle="None"
        ResizeMode="NoResize" Background="{DynamicResource WindowBackgroundBrush}"
        FlowDirection="RightToLeft" KeyDown="Window_KeyDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button x:Name="CloseButton" Grid.Column="0" Content="✕  بستن" Padding="16,8" Margin="0,0,8,0" Style="{StaticResource SecondaryButtonStyle}" Click="Close_Click"/>
                <Button x:Name="BackButton" Grid.Column="1" Content="←" Width="44" Margin="0,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="Back_Click"/>
                <Button x:Name="ForwardButton" Grid.Column="2" Content="→" Width="44" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}" Click="Forward_Click"/>
                <Border Grid.Column="3" CornerRadius="14" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,8">
                    <TextBlock x:Name="AddressText" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
                <Button Grid.Column="4" Content="↻" Width="44" Margin="10,0,6,0" Style="{StaticResource SecondaryButtonStyle}" Click="Reload_Click"/>
                <Button Grid.Column="5" Content="↗ مرورگر خارجی" Padding="14,8" Style="{StaticResource SecondaryButtonStyle}" Click="External_Click"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" x:Name="BrowserHost"/>
    </Grid>
</Window>